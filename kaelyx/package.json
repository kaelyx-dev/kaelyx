{
  "name": "kaelyx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "k:build:icons": "tsx scripts/BuildIconManifest.ts",
    "k:build:blog": "tsx scripts/BuildBlogManifest.ts",
    "k:build:projects": "tsx scripts/BuildProjectManifest.ts",
    "k:build:all": "run-p k:build:icons k:build:blog k:build:projects",
    "k:deploy": "tsx scripts/Publish.ts",
    "k:deploy:dry-run": "tsx scripts/Publish.ts --dry-run",
    "k:blog:new": "tsx scripts/blog/NewPost.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/gh-pages": "^6.1.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.99.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
